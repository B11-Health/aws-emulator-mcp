{
  "schemaVersion": 1,
  "name": "independent-s3-object-write",
  "services": ["s3"],
  "setup": [
    {"id": "bucket", "service": "s3", "operation": "CreateBucket",
     "parameters": {"Bucket": {"$fixture": "bucket"}}}
  ],
  "invoke": {
    "entrypoint": "handle", "times": 1,
    "inputs": {
      "bucket": {"$fixture": "bucket"},
      "key": "sample.txt",
      "data": "synthetic-v1"
    },
    "expectedCalls": [
      {"service": "s3", "operation": "PutObject", "min": 1, "max": 1}
    ]
  },
  "checks": [
    {"id": "head", "service": "s3", "operation": "HeadObject",
     "parameters": {"Bucket": {"$fixture": "bucket"}, "Key": "sample.txt"},
     "expect": {"assertions": [{"path": "ContentLength", "equals": 12}]}}
  ],
  "cleanup": [
    {"id": "remove", "service": "s3", "operation": "DeleteObject",
     "parameters": {"Bucket": {"$fixture": "bucket"}, "Key": "sample.txt"}},
    {"id": "delete", "service": "s3", "operation": "DeleteBucket",
     "parameters": {"Bucket": {"$fixture": "bucket"}}}
  ],
  "regression": {"stepId": "head", "path": "ContentLength"}
}
