{
  "schemaVersion": 1,
  "name": "order-intake",
  "description": "Synthetic order intake with receipts, order records and fulfillment messages.",
  "actor": {
    "id": "OrderApp",
    "label": "Order API (conceptual)"
  },
  "resources": [
    {
      "id": "ReceiptsBucket",
      "type": "s3-bucket",
      "label": "Receipt storage"
    },
    {
      "id": "OrdersTable",
      "type": "dynamodb-table",
      "label": "Order records",
      "partitionKey": "orderId"
    },
    {
      "id": "FulfillmentQueue",
      "type": "sqs-queue",
      "label": "Fulfillment events"
    }
  ],
  "flows": [
    {
      "from": "OrderApp",
      "to": "ReceiptsBucket",
      "label": "Save receipt"
    },
    {
      "from": "OrderApp",
      "to": "OrdersTable",
      "label": "Store order"
    },
    {
      "from": "OrderApp",
      "to": "FulfillmentQueue",
      "label": "Publish event"
    }
  ]
}
