{
  "name": "aws-emulator-mcp",
  "version": "0.4.0-beta.4",
  "description": "Local-first MCP adapter for the official AWS Emulator with an isolated Docker lab",
  "type": "module",
  "bin": {
    "aws-emulator-mcp": "./bin/aws-emulator-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "docker/",
    "scripts/install_wsl.sh",
    "src/aws_emulator_mcp/",
    "docs/assets/",
    "docs/COVERAGE.md",
    "docs/DOCKER_NPM_BETA.md",
    "docs/EXPERIMENT_LABS.md",
    "docs/WHAT_YOU_CAN_BUILD.md",
    "docs/PRODUCT_VISION.md",
    "docs/COMPETITIVE_BENCHMARK.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B11-Health/aws-emulator-mcp.git"
  },
  "keywords": [
    "aws",
    "aws-emulator",
    "mcp",
    "ai-agents",
    "docker",
    "devtools",
    "local-cloud"
  ],
  "scripts": {
    "test": "node --test tests/node_cli.test.mjs",
    "pack:check": "npm pack --dry-run --json",
    "qa": "npm test && npm run pack:check"
  }
}
