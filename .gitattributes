# Normalize portable source while preserving the correct platform line endings.
.gitattributes text eol=lf
.gitignore text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Unified diffs use space-prefixed context lines; these are not trailing data whitespace.
*.patch text eol=lf whitespace=-blank-at-eol
